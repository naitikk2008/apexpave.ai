<script>
  const TOTAL = 10;
  let cur = 1;
  const dotNav = document.getElementById('dot-nav');
  for (let i = 1; i <= TOTAL; i++) {
    const d = document.createElement('div');
    d.className = 'dot' + (i === 1 ? ' active' : '');
    d.addEventListener('click', () => goTo(i));
    dotNav.appendChild(d);
  }
  function updateUI() {
    document.getElementById('slide-counter').textContent = cur + ' / ' + TOTAL;
    document.getElementById('slide-num-fixed').textContent = String(cur).padStart(2,'0') + ' / ' + String(TOTAL).padStart(2,'0');
    document.getElementById('progress-bar').style.width = (cur / TOTAL * 100) + '%';
    document.querySelectorAll('.dot').forEach((d, i) => d.classList.toggle('active', i + 1 === cur));
  }
  function goTo(n) {
    const prev = document.getElementById('slide-' + cur);
    prev.classList.remove('active');
    prev.classList.add('exit');
    setTimeout(() => prev.classList.remove('exit'), 600);
    cur = Math.max(1, Math.min(TOTAL, n));
    document.getElementById('slide-' + cur).classList.add('active');
    updateUI();
  }
  function changeSlide(dir) { goTo(cur + dir); }
  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') changeSlide(1);
    if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') changeSlide(-1);
  });
  let tx = 0;
  document.addEventListener('touchstart', e => { tx = e.touches[0].clientX; });
  document.addEventListener('touchend', e => { const dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 50) changeSlide(dx < 0 ? 1 : -1); });
  updateUI();
</script>
